# ==================================================
# Application
# ==================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_TRUST_PROXY=false
BODY_LIMIT=10mb

# ==================================================
# CORS
# ==================================================
CORS_ORIGIN=http://localhost:3000

# ==================================================
# MongoDB
# ==================================================
MONGODB_URI=mongodb://localhost:27017/perfume-store
MONGODB_RETRY_ATTEMPTS=3
MONGODB_RETRY_DELAY=1000

# ==================================================
# JWT
# ==================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=luxury-perfume-store-api
JWT_AUDIENCE=luxury-perfume-store-clients
JWT_ALGORITHM=HS256

# ==================================================
# Cloudinary
# ==================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=perfume-store

# ==================================================
# Throttler (Rate Limiting)
# ==================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5

# ==================================================
# Swagger
# ==================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ==================================================
# AI Recommendation Engine (Gemini + Atlas Vector Search)
# ==================================================
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash
MONGODB_VECTOR_INDEX_NAME=knowledge_vector_index
AI_VECTOR_TOP_K=5
AI_PRODUCT_TOP_K=8
